rules_version = '2';

// Freedom ChMS access rules.
// Every request is checked here, on the server. Hiding a button in the app is
// only a convenience; these rules are what actually protect the data.
//
// - A user's role and permissions live on users/{uid}. Only Cloud Functions
//   (Admin SDK) write that document, so a user cannot raise their own access.
// - Organization data is separated by organization id. A user reaches an
//   organization only if it is in their orgIds or they have allOrgs.
// - Nothing is hard-deleted from the app. "Delete" sets deletedAt; a scheduled
//   function purges soft-deleted records after 30 days.
// - Every write must carry who made it and the server time, so the audit
//   trigger can record the actor.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function profilePath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }
    function me() {
      return get(profilePath()).data;
    }
    function isActive() {
      return signedIn() && exists(profilePath()) && me().active == true;
    }
    function has(permission) {
      return isActive() && permission in me().permissions;
    }
    // A trainer reads only their department's class list (rosters), never people
    // or students: their accounts carry no people.read (Andy, 2026-10-28).
    function isTrainer() {
      return isActive() && me().roleId == 'trainer';
    }
    function myClasses() {
      return me().get('registerClasses', []);
    }
    function myDepartments() {
      return me().get('trainerCourseIds', []);
    }
    function hasAllOrgs() {
      return isActive() && me().allOrgs == true;
    }
    function canAccessOrg(orgId) {
      return isActive() && (me().allOrgs == true || orgId in me().orgIds);
    }

    function stampedCreate() {
      let d = request.resource.data;
      return d.createdBy == request.auth.uid
        && d.createdAt == request.time
        && d.updatedBy == request.auth.uid
        && d.updatedAt == request.time;
    }
    function stampedUpdate() {
      let d = request.resource.data;
      return d.createdBy == resource.data.createdBy
        && d.createdAt == resource.data.createdAt
        && d.updatedBy == request.auth.uid
        && d.updatedAt == request.time;
    }
    function validSoftDelete() {
      let d = request.resource.data;
      return (d.deletedAt == null && d.deletedBy == null)
        || (d.deletedAt == request.time && d.deletedBy == request.auth.uid)
        || (d.deletedAt == resource.data.deletedAt && d.deletedBy == resource.data.deletedBy);
    }

    // ---- Users and roles --------------------------------------------------

    // An organization head may read the Staff accounts of their own organizations (see canManageTeamAccount).
    function isMyTeamAccount(d) {
      return has('team.manage') && me().allOrgs != true
        && d.roleId == 'staff' && d.get('allOrgs', false) != true
        && d.orgIds.size() > 0 && d.orgIds.hasOnly(me().orgIds);
    }

    match /users/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || has('users.manage') || isMyTeamAccount(resource.data));
      allow list: if has('users.manage');
      allow write: if false; // Cloud Functions only
    }

    // Names of active staff, so follow-ups can be assigned without reading
    // private account details. Kept up to date by Cloud Functions.
    match /staff/{uid} {
      allow read: if isActive();
      allow write: if false;
    }

    match /roles/{roleId} {
      allow read: if isActive();
      // Changing a role triggers a function that recomputes everyone's permissions.
      allow create, update: if has('users.manage')
        && request.resource.data.keys().hasOnly(['name', 'isOwner', 'permissions', 'system',
             'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
        && request.resource.data.name is string
        && request.resource.data.permissions is list
        && (resource == null ? stampedCreate() : stampedUpdate())
        // The built-in pastor role cannot be weakened or renamed into a non-owner.
        && (roleId != 'pastor' || request.resource.data.isOwner == true);
      allow delete: if false;
    }

    // WhatsApp Cloud API settings. The access token is never stored here: it is a Firebase secret.
    function validWhatsAppSettings(d) {
      return d.enabled is bool
        && d.phoneNumberId is string && d.phoneNumberId.size() <= 30
        && d.modes is map
        && d.modes.keys().hasOnly(['visitor_welcome', 'checkin_48h', 'care_absent', 'child_absent'])
        && d.get('language', 'en') is string && d.get('language', 'en').size() <= 10;
    }

    match /settings/{settingId} {
      allow read: if isActive();
      allow create: if has('settings.manage') && stampedCreate()
        && (settingId != 'pipeline'
            || request.resource.data.sensitiveStageIds.hasAll(['salvation', 'baptism']))
        && (settingId != 'whatsapp' || validWhatsAppSettings(request.resource.data));
      allow update: if has('settings.manage') && stampedUpdate()
        // A stage marked sensitive stays sensitive, so salvation and baptism
        // records can never be exposed to admins by editing the stage list.
        && (settingId != 'pipeline'
            || request.resource.data.sensitiveStageIds.hasAll(resource.data.sensitiveStageIds))
        && (settingId != 'whatsapp' || validWhatsAppSettings(request.resource.data));
      allow delete: if false;
    }

    // ---- Organizations ----------------------------------------------------

    function validOrganization() {
      let d = request.resource.data;
      return d.keys().hasOnly(['name', 'type', 'parentId', 'timeZone', 'currency', 'receiptPrefix',
               'serviceTimes', 'activities', 'active', 'training', 'deletedAt', 'deletedBy', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
        && d.name is string && d.name.size() >= 2 && d.name.size() <= 120
        && d.type in ['church_campus', 'college', 'ministry']
        && (d.parentId == null || d.parentId is string)
        && d.timeZone is string
        && d.currency is string && d.currency.matches('^[A-Z]{3}$')
        && d.receiptPrefix is string && d.receiptPrefix.matches('^[A-Z]{2,6}$')
        && d.active is bool
        && (!('serviceTimes' in d) || (d.serviceTimes is list && d.serviceTimes.size() <= 20))
        && (!('activities' in d) || (d.activities is list && d.activities.size() <= 30));
    }

    function stampedWrite() {
      return resource == null ? stampedCreate() : stampedUpdate();
    }
    function freshRecord() {
      return request.resource.data.deletedAt == null && request.resource.data.deletedBy == null;
    }
    function orgWrite(orgId, permission) {
      return canAccessOrg(orgId) && has(permission)
        && request.resource.data.orgId == orgId
        && (resource == null ? stampedCreate() && freshRecord() : stampedUpdate() && validSoftDelete());
    }

    // ---- People -----------------------------------------------------------

    function validPerson() {
      let d = request.resource.data;
      return d.keys().hasOnly(['orgId', 'fullName', 'firstName', 'phone', 'whatsapp', 'whatsappConsent',
               'email', 'status', 'firstVisitDate', 'gender', 'householdId', 'guardianId', 'howHeard',
               'invitedBy', 'invitedById', 'serviceAttended', 'customFields', 'possibleDuplicateIds',
               'deletedAt', 'deletedBy', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
        && d.fullName is string && d.fullName.size() >= 1 && d.fullName.size() <= 120
        && d.status in ['visitor', 'regular', 'member', 'student', 'child', 'inactive']
        && (d.phone == null || (d.phone is string && d.phone.matches('^[+][0-9]{8,15}$')))
        && (d.whatsapp == null || (d.whatsapp is string && d.whatsapp.matches('^[+][0-9]{8,15}$')))
        && d.whatsappConsent is map
        && (!('customFields' in d) || d.customFields is map);
    }

    function sensitiveStages() {
      return get(/databases/$(database)/documents/settings/pipeline).data.sensitiveStageIds;
    }

    match /organizations/{orgId} {
      allow get: if canAccessOrg(orgId);
      allow list: if hasAllOrgs();
      // Only someone who sees every organization can add one, so a new campus
      // is never created by a user who would then be locked out of it.
      allow create: if has('settings.manage') && hasAllOrgs()
        && validOrganization() && stampedCreate()
        && request.resource.data.deletedAt == null && request.resource.data.deletedBy == null;
      allow update: if has('settings.manage') && canAccessOrg(orgId)
        && validOrganization() && stampedUpdate() && validSoftDelete();
      allow delete: if false;

      // Organization data. Anything not matched here is denied.

      match /people/{personId} {
        allow read: if canAccessOrg(orgId) && has('people.read');
        allow create, update: if orgWrite(orgId, 'people.write') && validPerson();
        allow delete: if false;
      }

      // One entry per person per pipeline stage. Salvation and baptism entries
      // are "sensitive": only staff with pastoral access can read or write them,
      // and the flag must match the stage list in settings/pipeline.
      match /pipeline/{entryId} {
        allow read: if canAccessOrg(orgId) && has('people.read')
          && (resource.data.sensitive == false || has('pastoral.read'));
        allow create, update: if orgWrite(orgId, 'people.write')
          && request.resource.data.keys().hasOnly(['orgId', 'personId', 'stageId', 'sensitive', 'status', 'date',
               'notes', 'details', 'deletedAt', 'deletedBy', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
          && entryId == request.resource.data.personId + '_' + request.resource.data.stageId
          && request.resource.data.status in ['not_started', 'in_progress', 'completed', 'dropped']
          && request.resource.data.sensitive == (request.resource.data.stageId in sensitiveStages())
          && (request.resource.data.sensitive == false || has('pastoral.read'))
          && (resource == null || resource.data.sensitive == false || has('pastoral.read'));
        allow delete: if false;
      }

      // Prayer needs can be written down by any staff member taking a visitor's
      // details, but only staff with pastoral access can read them.
      match /prayerRequests/{requestId} {
        allow read: if canAccessOrg(orgId) && has('pastoral.read');
        allow create: if orgWrite(orgId, 'people.write')
          && request.resource.data.keys().hasOnly(['orgId', 'personId', 'text', 'status',
               'deletedAt', 'deletedBy', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
          && request.resource.data.text is string && request.resource.data.text.size() <= 2000;
        allow update: if orgWrite(orgId, 'pastoral.read');
        allow delete: if false;
      }

      match /pastoralNotes/{noteId} {
        allow read: if canAccessOrg(orgId) && has('pastoral.read');
        allow create, update: if orgWrite(orgId, 'pastoral.read')
          && request.resource.data.keys().hasOnly(['orgId', 'personId', 'text',
               'deletedAt', 'deletedBy', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
          && request.resource.data.text is string && request.resource.data.text.size() <= 5000;
        allow delete: if false;
      }

      // ---- Services, classes and sessions ---------------------------------

      // One record per gathering per day. The id is the date plus the name, so
      // two devices opening the same service offline land on the same record.
      function validCount(h, key) {
        return !(key in h) || (h[key] is int && h[key] >= 0 && h[key] <= 100000);
      }
      function validEvent(eventId) {
        let d = request.resource.data;
        let h = d.headcounts;
        return d.keys().hasOnly(['orgId', 'date', 'type', 'name', 'activity', 'headcounts', 'notes',
                 'programId', 'cohortId', 'topicIds', 'mentor', 'mentorId', 'groupId',
                 'deletedAt', 'deletedBy', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
          && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && eventId.matches('^' + d.date + '_[A-Za-z0-9_]+$')
          && d.type in ['service', 'class', 'session', 'meal', 'group']
          && d.name is string && d.name.size() >= 1 && d.name.size() <= 120
          && (!('activity' in d) || d.activity == null || (d.activity is string && d.activity.size() <= 120))
          && (!('notes' in d) || (d.notes is string && d.notes.size() <= 2000))
          && h is map
          && h.keys().hasOnly(['adults', 'teens', 'children', 'new', 'returning', 'total'])
          && validCount(h, 'adults') && validCount(h, 'teens') && validCount(h, 'children')
          && validCount(h, 'new') && validCount(h, 'returning') && validCount(h, 'total')
          && validProgramSession(eventId, d)
          && validGroupMeeting(eventId, d);
      }
      // A programme class: belongs to a real programme, covers up to ten of its
      // topics, and records who taught it. Its id says which programme and cohort.
      function validProgramSession(eventId, d) {
        return d.get('programId', null) == null
          ? !('cohortId' in d) && !('topicIds' in d) && !('mentor' in d) && !('mentorId' in d)
          : d.type == 'class'
            && existsAfter(/databases/$(database)/documents/organizations/$(orgId)/programs/$(d.programId))
            && (d.cohortId == null || d.cohortId is string)
            && eventId == d.date + '_' + d.programId + '_' + (d.cohortId == null ? 'makeup' : d.cohortId)
            && d.topicIds is list && d.topicIds.size() <= 10
            && (d.mentor == null || (d.mentor is string && d.mentor.size() <= 120))
            && (d.mentorId == null || d.mentorId is string);
      }
      function validGroupMeeting(eventId, d) {
        return d.get('groupId', null) == null
          ? d.type != 'group'
          : d.type == 'group'
            && eventId == d.date + '_group_' + d.groupId
            && existsAfter(/databases/$(database)/documents/organizations/$(orgId)/groups/$(d.groupId));
      }

      // An ADIA trainer marks the register of their own classes only, named on their account
      // (Andy, 2026-10-26): no other class, no headcounts, no deleting.
      function dayOf(d) {
        let p = d.split('-');
        return timestamp.date(int(p[0]), int(p[1]), int(p[2]));
      }
      function registerTrainer(orgId, e) {
        return canAccessOrg(orgId) && has('exams.mark') && e.type == 'class'
          && e.name in myClasses()
        // Today or yesterday only (Andy, 2026-10-28, 4B); a day's leeway for Nairobi time.
        && dayOf(e.date) >= request.time - duration.value(2, 'd')
        && dayOf(e.date) <= request.time + duration.value(1, 'd')
          && request.resource.data.orgId == orgId
          && (resource == null ? stampedCreate() && freshRecord() : stampedUpdate() && validSoftDelete());
      }
      function trainerEvent(orgId) {
        let d = request.resource.data;
        return registerTrainer(orgId, d) && d.get('deletedAt', null) == null
          && d.get('programId', null) == null && d.get('groupId', null) == null
          && (resource == null || (resource.data.name == d.name && resource.data.headcounts == d.headcounts));
      }
      match /events/{eventId} {
        allow read: if canAccessOrg(orgId) && (has('people.read') || has('attendance.write')
          || (isTrainer() && resource.data.type == 'class' && resource.data.name in myClasses()));
        allow create, update: if (orgWrite(orgId, 'attendance.write') || trainerEvent(orgId)) && validEvent(eventId);
        allow delete: if false;
      }

      // One record per person per gathering. It must point at a real gathering
      // and a real person in this organization, on the gathering's date.
      // A check-in carries its gathering's date, programme and group, so a
      // person's programme progress can be counted without reading every class.
      function attendanceMatchesEvent(e) {
        let d = request.resource.data;
        return e.date == d.date
          && d.get('programId', null) == e.get('programId', null)
          && d.get('groupId', null) == e.get('groupId', null);
      }

      match /attendance/{recordId} {
        allow read: if canAccessOrg(orgId) && (has('people.read') || has('attendance.write')
          || (isTrainer() && get(/databases/$(database)/documents/organizations/$(orgId)/events/$(resource.data.eventId)).data.name in myClasses()));
        allow create, update: if (orgWrite(orgId, 'attendance.write')
               || (registerTrainer(orgId, getAfter(/databases/$(database)/documents/organizations/$(orgId)/events/$(request.resource.data.eventId)).data)
                   && get(/databases/$(database)/documents/organizations/$(orgId)/students/$(request.resource.data.personId)).data.courseId in myDepartments()))
          && request.resource.data.keys().hasOnly(['orgId', 'eventId', 'personId', 'date', 'status', 'method', 'checkedInAt',
               'programId', 'groupId', 'deletedAt', 'deletedBy', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
          && recordId == request.resource.data.eventId + '_' + request.resource.data.personId
          && request.resource.data.status in ['present', 'late', 'absent', 'excused']
          && request.resource.data.method in ['staff', 'door', 'register']
          && request.resource.data.checkedInAt is timestamp
          && (resource == null || (request.resource.data.eventId == resource.data.eventId
                                   && request.resource.data.personId == resource.data.personId))
          && attendanceMatchesEvent(getAfter(/databases/$(database)/documents/organizations/$(orgId)/events/$(request.resource.data.eventId)).data)
          && existsAfter(/databases/$(database)/documents/organizations/$(orgId)/people/$(request.resource.data.personId));
        allow delete: if false;
      }

      // ---- Programmes, Dream Team and Freedom Groups ----------------------

      function isDate(v) {
        return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
      }
      function optionalDate(v) {
        return v == null || isDate(v);
      }
      function shortText(v, max) {
        return v is string && v.size() <= max;
      }
      function existsInOrg(collection, id) {
        return existsAfter(/databases/$(database)/documents/organizations/$(orgId)/$(collection)/$(id));
      }
      function programsRead() {
        return canAccessOrg(orgId) && (has('people.read') || has('attendance.write'));
      }

      // A programme's topics and completion rule are configuration: the pastor
      // (or staff with settings access) changes them. Ids are readable words,
      // so a class's id can name its programme.
      match /programs/{programId} {
        allow read: if programsRead();
        allow create, update: if orgWrite(orgId, 'settings.manage')
          && programId.matches('^[a-z0-9_]{2,60}$')
          && request.resource.data.keys().hasOnly(['orgId', 'name', 'description', 'topics', 'completionRule',
               'pipelineStageId', 'completedLabel', 'schedule', 'active',
               'deletedAt', 'deletedBy', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
          && request.resource.data.name is string && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 80
          && shortText(request.resource.data.description, 500)
          && request.resource.data.topics is list && request.resource.data.topics.size() <= 60
          && request.resource.data.completionRule is map
          && request.resource.data.completionRule.type in ['all_topics', 'topic_count']
          && (request.resource.data.completionRule.type == 'all_topics'
              || (request.resource.data.completionRule.count is int && request.resource.data.completionRule.count >= 1))
          && (request.resource.data.pipelineStageId == null || request.resource.data.pipelineStageId is string)
          && shortText(request.resource.data.completedLabel, 30)
          && shortText(request.resource.data.schedule, 80)
          && request.resource.data.active is bool;
        allow delete: if false;
      }

      match /cohorts/{cohortId} {
        allow read: if programsRead();
        allow create, update: if orgWrite(orgId, 'programs.write')
          && cohortId.matches('^[A-Za-z0-9]{4,40}$')
          && request.resource.data.keys().hasOnly(['orgId', 'programId', 'name', 'startDate', 'endDate', 'schedule', 'active',
               'deletedAt', 'deletedBy', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
          && existsInOrg('programs', request.resource.data.programId)
          && (resource == null || request.resource.data.programId == resource.data.programId)
          && request.resource.data.name is string && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 80
          && isDate(request.resource.data.startDate)
          && optionalDate(request.resource.data.endDate)
          && shortText(request.resource.data.schedule, 80)
          && request.resource.data.active is bool;
        allow delete: if false;
      }

      // One enrolment per person per programme. Progress (topicsCovered) is
      // recounted by a Cloud Function from class attendance.
      match /enrollments/{enrollmentId} {
        allow read: if programsRead();
        allow create, update: if orgWrite(orgId, 'programs.write')
          && request.resource.data.keys().hasOnly(['orgId', 'programId', 'personId', 'cohortId', 'status', 'enrolledDate',
               'completedDate', 'completedAuto', 'topicsCovered', 'notes',
               'deletedAt', 'deletedBy', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
          && enrollmentId == request.resource.data.programId + '_' + request.resource.data.personId
          && existsInOrg('programs', request.resource.data.programId)
          && existsInOrg('people', request.resource.data.personId)
          && (request.resource.data.cohortId == null || existsInOrg('cohorts', request.resource.data.cohortId))
          && request.resource.data.status in ['active', 'completed', 'dropped']
          && isDate(request.resource.data.enrolledDate)
          && optionalDate(request.resource.data.completedDate)
          && request.resource.data.completedAuto is bool
          && request.resource.data.topicsCovered is list && request.resource.data.topicsCovered.size() <= 60
          && shortText(request.resource.data.notes, 1000);
        allow delete: if false;
      }

      // Dream Team departments and who serves in them.
      match /teams/{teamId} {
        allow read: if canAccessOrg(orgId) && has('people.read');
        allow create, update: if orgWrite(orgId, 'programs.write')
          && request.resource.data.keys().hasOnly(['orgId', 'name', 'leaderId', 'leaderName', 'active',
               'deletedAt', 'deletedBy', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
          && request.resource.data.name is string && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 80
          && (request.resource.data.leaderId == null || request.resource.data.leaderId is string)
          && shortText(request.resource.data.leaderName, 120)
          && request.resource.data.active is bool;
        allow delete: if false;
      }

      match /teamMembers/{memberId} {
        allow read: if canAccessOrg(orgId) && has('people.read');
        allow create, update: if orgWrite(orgId, 'programs.write')
          && request.resource.data.keys().hasOnly(['orgId', 'teamId', 'personId', 'role', 'startDate', 'endDate', 'status',
               'deletedAt', 'deletedBy', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
          && memberId == request.resource.data.teamId + '_' + request.resource.data.personId
          && existsInOrg('teams', request.resource.data.teamId)
          && existsInOrg('people', request.resource.data.personId)
          && shortText(request.resource.data.role, 80)
          && isDate(request.resource.data.startDate)
          && optionalDate(request.resource.data.endDate)
          && request.resource.data.status in ['active', 'inactive'];
        allow delete: if false;
      }

      // Freedom Groups (small groups) and their members. Weekly meetings are
      // gatherings in /events with the group's id.
      match /groups/{groupId} {
        allow read: if programsRead();
        allow create, update: if orgWrite(orgId, 'programs.write')
          && groupId.matches('^[A-Za-z0-9]{4,40}$')
          && request.resource.data.keys().hasOnly(['orgId', 'name', 'leaderId', 'leaderName', 'meetingDay', 'meetingTime',
               'place', 'startDate', 'active', 'deletedAt', 'deletedBy', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
          && request.resource.data.name is string && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 80
          && (request.resource.data.leaderId == null || request.resource.data.leaderId is string)
          && shortText(request.resource.data.leaderName, 120)
          && request.resource.data.meetingDay in ['monday', 'tuesday', 'wednesday', 'thursday', 'friday', 'saturday', 'sunday']
          && shortText(request.resource.data.meetingTime, 20)
          && shortText(request.resource.data.place, 120)
          && isDate(request.resource.data.startDate)
          && request.resource.data.active is bool;
        allow delete: if false;
      }

      match /groupMembers/{memberId} {
        allow read: if programsRead();
        allow create, update: if orgWrite(orgId, 'programs.write')
          && request.resource.data.keys().hasOnly(['orgId', 'groupId', 'personId', 'joinedDate', 'leftDate', 'status',
               'deletedAt', 'deletedBy', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
          && memberId == request.resource.data.groupId + '_' + request.resource.data.personId
          && existsInOrg('groups', request.resource.data.groupId)
          && existsInOrg('people', request.resource.data.personId)
          && isDate(request.resource.data.joinedDate)
          && optionalDate(request.resource.data.leftDate)
          && request.resource.data.status in ['active', 'left'];
        allow delete: if false;
      }

      // ---- Giving (church campuses and later ADIA fees) ----------------------
      //
      // Per-person giving is private: only staff with giving.person.read (the
      // pastor by default) read every gift. Staff who record gifts read the
      // gifts they entered or confirmed, and the Unassigned queue, so they can
      // print a receipt without seeing anyone's history.

      function givingRead() {
        return canAccessOrg(orgId) && has('giving.person.read');
      }

      // Funds are configuration, like programmes.
      match /funds/{fundId} {
        allow read: if canAccessOrg(orgId) && (has('gifts.write') || has('finance.reports') || has('giving.person.read'));
        allow create, update: if orgWrite(orgId, 'settings.manage')
          && fundId.matches('^[a-z0-9_]{2,40}$')
          && request.resource.data.keys().hasOnly(['orgId', 'name', 'aliases', 'active',
               'deletedAt', 'deletedBy', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
          && request.resource.data.name is string && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 40
          && request.resource.data.aliases is list && request.resource.data.aliases.size() <= 10
          && request.resource.data.active is bool;
        allow delete: if false;
      }

      function giftFieldsValid() {
        let d = request.resource.data;
        return d.keys().hasOnly(['orgId', 'personId', 'giverName', 'phone', 'date', 'amountCents', 'fundId',
               'method', 'mpesaCode', 'accountRef', 'status', 'unassignedReason', 'receivedBy', 'receivedByName',
               'handledBy', 'notes', 'importId', 'receiptNumber', 'receiptIssuedAt', 'voidReason', 'voidedAt',
               'deletedAt', 'deletedBy', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
          && d.orgId == orgId
          && (d.personId == null || (d.personId is string && existsInOrg('people', d.personId)))
          && shortText(d.giverName, 120)
          && (d.phone == null || (d.phone is string && d.phone.matches('^[+]?[0-9*]{4,16}$')))
          && isDate(d.date)
          && d.amountCents is int && d.amountCents > 0 && d.amountCents <= 10000000000
          && (d.fundId == null || (d.fundId is string && existsInOrg('funds', d.fundId)))
          && d.method in ['mpesa', 'cash', 'bank', 'cheque']
          && (d.method == 'mpesa'
              ? (d.mpesaCode is string && d.mpesaCode.matches('^[A-Z0-9]{8,12}$'))
              : d.mpesaCode == null)
          && shortText(d.accountRef, 60)
          && d.status in ['confirmed', 'unassigned', 'void']
          && (d.unassignedReason == null || d.unassignedReason in ['person', 'fund', 'both'])
          && shortText(d.receivedByName, 120)
          && shortText(d.notes, 500)
          && (d.importId == null || d.importId is string)
          && d.deletedAt == null && d.deletedBy == null
          // A confirmed gift names its giver and fund, so its receipt is complete.
          && (d.status != 'confirmed' || (d.fundId != null && d.giverName.size() >= 1));
      }

      // Each M-Pesa code can be recorded once. Its entry here is written in the
      // same batch as the gift, and a second gift with the same code is refused.
      function mpesaCodeIsMine(giftId) {
        let d = request.resource.data;
        return d.method != 'mpesa'
          || getAfter(/databases/$(database)/documents/organizations/$(orgId)/mpesaCodes/$(d.mpesaCode)).data.giftId == giftId;
      }

      match /gifts/{giftId} {
        function giftIsMine() {
          return canAccessOrg(orgId) && has('gifts.write')
            && (resource.data.createdBy == request.auth.uid
                || resource.data.handledBy == request.auth.uid
                || resource.data.status == 'unassigned');
        }
        allow read: if givingRead() || giftIsMine();
        allow create: if canAccessOrg(orgId) && has('gifts.write') && stampedCreate()
          && giftId.matches('^[A-Za-z0-9]{10,40}$')
          && giftFieldsValid()
          && request.resource.data.status in ['confirmed', 'unassigned']
          && request.resource.data.receivedBy == request.auth.uid
          && request.resource.data.handledBy == (request.resource.data.status == 'confirmed' ? request.auth.uid : null)
          && request.resource.data.receiptNumber == null
          && request.resource.data.receiptIssuedAt == null
          && request.resource.data.voidReason == null
          && request.resource.data.voidedAt == null
          && mpesaCodeIsMine(giftId);
        // Money facts never change after entry: a mistake is voided and entered
        // again. Once a receipt is numbered, its giver and fund are fixed too.
        allow update: if canAccessOrg(orgId) && has('gifts.write') && (givingRead() || giftIsMine())
          && stampedUpdate()
          && giftFieldsValid()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['personId', 'giverName', 'phone', 'fundId',
               'status', 'unassignedReason', 'handledBy', 'notes', 'voidReason', 'voidedAt', 'updatedAt', 'updatedBy'])
          && resource.data.status != 'void'
          && (resource.data.receiptNumber == null
              || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['giverName', 'phone', 'fundId']))
          // ...except that a gift recorded with a name only can be linked to that person later.
          && (resource.data.receiptNumber == null || resource.data.personId == null
              || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['personId']))
          && (request.resource.data.status == resource.data.status
              || (resource.data.status == 'unassigned' && request.resource.data.status == 'confirmed')
              || request.resource.data.status == 'void')
          // Whoever confirms a payment from the queue is the one who handled it.
          && (resource.data.status == 'unassigned' && request.resource.data.status == 'confirmed'
              ? request.resource.data.handledBy == request.auth.uid
              : request.resource.data.handledBy == resource.data.handledBy)
          && (request.resource.data.status != 'void'
              || (request.resource.data.voidReason is string && request.resource.data.voidReason.size() >= 3
                  && request.resource.data.voidedAt == request.time));
        allow delete: if false;
      }

      // The entry names the gift and its amount, so an import can tell when a
      // payment typed in by hand has a different amount from the statement.
      function codeEntryValid(code) {
        let d = request.resource.data;
        let g = getAfter(/databases/$(database)/documents/organizations/$(orgId)/gifts/$(d.giftId)).data;
        return d.keys().hasOnly(['orgId', 'giftId', 'amountCents', 'createdAt', 'createdBy'])
          && d.orgId == orgId
          && d.createdBy == request.auth.uid
          && d.createdAt == request.time
          && g.mpesaCode == code
          && d.amountCents == g.amountCents;
      }

      match /mpesaCodes/{code} {
        // Holds only the gift id; finance staff use it to find statement lines with no gift.
        allow read: if canAccessOrg(orgId) && (has('gifts.write') || has('finance.reports'));
        allow create: if canAccessOrg(orgId) && has('gifts.write')
          && code.matches('^[A-Z0-9]{8,12}$')
          && codeEntryValid(code);
        // Re-entering a payment after its gift was voided points the code at the new gift.
        allow update: if canAccessOrg(orgId) && has('gifts.write')
          && codeEntryValid(code)
          && get(/databases/$(database)/documents/organizations/$(orgId)/gifts/$(resource.data.giftId)).data.status == 'void';
        allow delete: if false;
      }

      // A gift saved on a device that the server then refused (for example the
      // same M-Pesa code recorded on two phones offline). Kept for staff to
      // check by hand, so nothing is lost or overwritten.
      match /giftReviews/{giftId} {
        allow read: if canAccessOrg(orgId) && (has('gifts.write') || has('giving.person.read'));
        allow create: if orgWrite(orgId, 'gifts.write')
          && request.resource.data.keys().hasOnly(['orgId', 'giftId', 'giverName', 'personId', 'date', 'amountCents', 'fundId',
               'method', 'mpesaCode', 'notes', 'savedAt', 'reason', 'status', 'resolvedNote',
               'deletedAt', 'deletedBy', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
          && request.resource.data.giftId == giftId
          && request.resource.data.status == 'open'
          && shortText(request.resource.data.reason, 300)
          && !exists(/databases/$(database)/documents/organizations/$(orgId)/gifts/$(giftId));
        allow update: if orgWrite(orgId, 'gifts.write')
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'resolvedNote', 'updatedAt', 'updatedBy'])
          && request.resource.data.status == 'resolved'
          && shortText(request.resource.data.resolvedNote, 500);
        allow delete: if false;
      }

      // Every completed line of an imported statement, by M-Pesa code, so the
      // month's M-Pesa giving can be checked against the statement total. Holds
      // no names or phone numbers. Importing the same line again changes nothing.
      match /statementLines/{code} {
        allow read: if canAccessOrg(orgId) && (has('gifts.write') || has('finance.reports'));
        allow create, update: if canAccessOrg(orgId) && has('gifts.write')
          && code.matches('^[A-Z0-9]{8,12}$')
          && request.resource.data.keys().hasOnly(['orgId', 'date', 'amountCents', 'importId', 'createdAt', 'createdBy'])
          && request.resource.data.orgId == orgId
          && isDate(request.resource.data.date)
          && request.resource.data.amountCents is int && request.resource.data.amountCents > 0
          && (resource == null
              ? (request.resource.data.createdBy == request.auth.uid && request.resource.data.createdAt == request.time)
              : (request.resource.data.date == resource.data.date
                 && request.resource.data.amountCents == resource.data.amountCents
                 && request.resource.data.importId == resource.data.importId
                 && request.resource.data.createdBy == resource.data.createdBy
                 && request.resource.data.createdAt == resource.data.createdAt));
        allow delete: if false;
      }

      // A record of each statement imported: totals only.
      match /giftImports/{importId} {
        allow read: if canAccessOrg(orgId) && (has('gifts.write') || has('finance.reports'));
        allow create: if orgWrite(orgId, 'gifts.write')
          && request.resource.data.keys().hasOnly(['orgId', 'fileName', 'firstDate', 'lastDate', 'statementTotalCents',
               'paymentCount', 'importedCount', 'importedCents', 'duplicateCount', 'duplicateCents', 'unassignedCount',
               'skippedCount', 'deletedAt', 'deletedBy', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
          && shortText(request.resource.data.fileName, 200);
        allow update, delete: if false;
      }

      // Messages the system sends by itself through the WhatsApp Cloud API. Cloud
      // Functions create them and send them; staff can only approve or cancel one
      // that is waiting. Salvation and baptism messages are never queued here.
      match /whatsappOutbox/{outboxId} {
        allow read: if canAccessOrg(orgId) && has('followups.manage');
        allow create, delete: if false;
        allow update: if canAccessOrg(orgId) && has('followups.manage')
          && resource.data.status == 'pending_approval'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'approvedBy', 'approvedByName', 'updatedAt', 'updatedBy'])
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.updatedAt == request.time
          && ((request.resource.data.status == 'queued'
               && request.resource.data.approvedBy == request.auth.uid
               && shortText(request.resource.data.approvedByName, 80))
              || request.resource.data.status == 'cancelled');
      }

      // Written only by Cloud Functions.
      match /receipts/{number} {
        allow read: if givingRead();
        allow write: if false;
      }
      match /ledger/{month} {
        allow read: if canAccessOrg(orgId) && has('finance.reports');
        allow write: if false;
      }
      match /counters/{counterId} {
        allow read, write: if false;
      }

      // ---- Follow-ups and WhatsApp messages --------------------------------

      // Salvation and baptism follow-ups reveal religious belief, so only staff
      // with pastoral access see them (the same rule as their journey stages).
      function pastoralReason(reason) {
        return reason in ['salvation', 'baptism_invite'];
      }
      function followUpVisible(d) {
        return !pastoralReason(d.reason) || has('pastoral.read');
      }
      function validAssignee(d) {
        return d.get('assignedTo', null) == null
          || (exists(/databases/$(database)/documents/users/$(d.assignedTo))
              && get(/databases/$(database)/documents/users/$(d.assignedTo)).data.active == true);
      }
      function validFollowUp(d) {
        return d.keys().hasOnly(['orgId', 'personId', 'personName', 'reason', 'templateId', 'status',
                 'assignedTo', 'assignedName', 'dueAt', 'outcome', 'note', 'doneAt', 'doneBy', 'lastMessageAt',
                 'absentSince', 'deletedAt', 'deletedBy', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
          && d.status in ['open', 'done']
          && d.dueAt is timestamp
          && shortText(d.get('personName', ''), 120)
          && shortText(d.get('note', ''), 1000)
          && (d.get('assignedName', null) == null || shortText(d.assignedName, 80))
          && (d.get('lastMessageAt', null) == null || d.lastMessageAt is timestamp)
          && validAssignee(d);
      }
      // Marking a task done records the outcome, who and when; reopening clears them.
      function validOutcome(d, before) {
        return d.status == 'open'
          ? d.get('outcome', null) == null && d.get('doneAt', null) == null && d.get('doneBy', null) == null
          : before != null && before.status == 'done'
            ? d.get('outcome', null) == before.get('outcome', null)
              && d.get('doneAt', null) == before.get('doneAt', null)
              && d.get('doneBy', null) == before.get('doneBy', null)
            : d.outcome in ['Reached', 'Message sent, no reply yet', 'No answer', 'Wrong number', 'Asked us to stop', 'Other']
              && d.doneAt == request.time && d.doneBy == request.auth.uid;
      }

      // Most tasks are created by Cloud Functions (a new visitor, a salvation,
      // three weeks absent). Staff can add their own and work through them all.
      match /followUps/{taskId} {
        allow read: if canAccessOrg(orgId) && has('followups.manage') && followUpVisible(resource.data);
        allow create: if orgWrite(orgId, 'followups.manage')
          && validFollowUp(request.resource.data)
          && request.resource.data.reason == 'other'
          && request.resource.data.status == 'open'
          && validOutcome(request.resource.data, null)
          && existsInOrg('people', request.resource.data.personId);
        allow update: if orgWrite(orgId, 'followups.manage')
          && followUpVisible(resource.data)
          && validFollowUp(request.resource.data)
          && request.resource.data.personId == resource.data.personId
          && request.resource.data.reason == resource.data.reason
          && request.resource.data.get('templateId', null) == resource.data.get('templateId', null)
          && request.resource.data.get('absentSince', null) == resource.data.get('absentSince', null)
          && validOutcome(request.resource.data, resource.data);
        allow delete: if false;
      }

      // A record of every WhatsApp message sent from the app: who sent it,
      // when, to whom and with which template. The words themselves are not
      // kept. Entries can't be changed or removed.
      match /messages/{messageId} {
        allow read: if canAccessOrg(orgId) && (has('followups.manage') || has('gifts.write'))
          && (resource.data.sensitive == false || has('pastoral.read'));
        allow create: if canAccessOrg(orgId) && (has('followups.manage') || has('gifts.write'))
          && request.resource.data.keys().hasOnly(['orgId', 'personId', 'toPersonId', 'toName', 'viaGuardian',
               'channel', 'templateId', 'templateName', 'followUpId', 'giftId', 'sensitive', 'senderName',
               'createdAt', 'createdBy'])
          && request.resource.data.orgId == orgId
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.channel == 'whatsapp'
          && request.resource.data.templateId is string
          && shortText(request.resource.data.templateName, 80)
          && shortText(request.resource.data.toName, 120)
          && shortText(request.resource.data.senderName, 80)
          && request.resource.data.viaGuardian is bool
          && request.resource.data.sensitive == (request.resource.data.templateId in ['salvation_followup', 'baptism_invite'])
          && (request.resource.data.sensitive == false || has('pastoral.read'))
          && (request.resource.data.followUpId == null || request.resource.data.followUpId is string)
          && (request.resource.data.giftId == null || request.resource.data.giftId is string)
          && existsInOrg('people', request.resource.data.personId)
          && existsInOrg('people', request.resource.data.toPersonId);
        allow update, delete: if false;
      }

      // ---- Reports -----------------------------------------------------------
      //
      // Weekly and monthly reports are made by Cloud Functions. The report
      // itself has counts only for salvations and baptisms; who was saved or
      // baptised is in private/pastoral, and giving in private/giving.

      match /reports/{reportId} {
        allow read: if canAccessOrg(orgId) && has('people.read');
        allow write: if false;

        match /private/{part} {
          allow read: if canAccessOrg(orgId)
            && ((part == 'pastoral' && has('pastoral.read'))
                || (part == 'giving' && has('finance.reports')));
          allow write: if false;
        }
      }

      // "Make a report" in the app. A Cloud Function makes it and marks the
      // request done. Only staff who manage settings can have it emailed.
      match /reportRequests/{requestId} {
        allow read: if canAccessOrg(orgId) && has('people.read');
        allow create: if canAccessOrg(orgId) && has('people.read')
          && request.resource.data.keys().hasOnly(['orgId', 'type', 'from', 'email', 'status', 'createdAt', 'createdBy'])
          && request.resource.data.orgId == orgId
          && request.resource.data.type in ['weekly', 'monthly']
          && isDate(request.resource.data.from)
          && request.resource.data.status == 'pending'
          && request.resource.data.email is bool
          && (request.resource.data.email == false || has('settings.manage'))
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }

      // ---- ADIA Training Centre ------------------------------------------
      // Courses, students, results, fees and certificates. Fee balances and
      // certificate serial numbers are written by Cloud Functions only.

      function schoolRead() {
        return canAccessOrg(orgId) && (has('people.read') || has('attendance.write'));
      }
      function feesRead() {
        return canAccessOrg(orgId) && (has('gifts.write') || has('finance.reports') || has('giving.person.read'));
      }
      // The principal keeps admission numbers and issues certificates without the wider Settings permission (Andy, 2026-10-25).
      function schoolManage() {
        return has('settings.manage') || has('school.manage');
      }
      function listOf(v, max) {
        return v is list && v.size() <= max;
      }

      match /courses/{courseId} {
        allow read: if schoolRead() || (canAccessOrg(orgId) && isTrainer());
        // The principal (school.manage) may add a department too, but not change one (Andy, 2026-10-25).
        allow create, update: if (orgWrite(orgId, 'settings.manage') || (resource == null && orgWrite(orgId, 'school.manage')))
          && courseId.matches('^[a-z0-9_]{2,40}$')
          && request.resource.data.keys().hasOnly(['orgId', 'name', 'levels', 'units', 'timetable', 'active',
               'deletedAt', 'deletedBy', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
          && shortText(request.resource.data.name, 120) && request.resource.data.name.size() >= 2
          && listOf(request.resource.data.levels, 12)
          && listOf(request.resource.data.units, 60)
          && listOf(request.resource.data.timetable, 40)
          && request.resource.data.active is bool;
        allow delete: if false;
      }

      match /intakes/{intakeId} {
        allow read: if schoolRead() || (canAccessOrg(orgId) && isTrainer());
        // ...and start a new cohort, which is one new intake for each programme.
        allow create, update: if (orgWrite(orgId, 'settings.manage') || (resource == null && orgWrite(orgId, 'school.manage')))
          && request.resource.data.keys().hasOnly(['orgId', 'courseId', 'name', 'startDate', 'capacity', 'active',
               'deletedAt', 'deletedBy', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
          && existsInOrg('courses', request.resource.data.courseId)
          && shortText(request.resource.data.name, 80) && request.resource.data.name.size() >= 1
          && isDate(request.resource.data.startDate)
          && (request.resource.data.capacity == null || (request.resource.data.capacity is int && request.resource.data.capacity >= 0 && request.resource.data.capacity <= 5000))
          && request.resource.data.active is bool;
        allow delete: if false;
      }

      // Grading scale, pass mark, weights and the attendance alert threshold.
      match /schoolSettings/{settingId} {
        allow read: if schoolRead() || (canAccessOrg(orgId) && isTrainer());
        allow create, update: if orgWrite(orgId, 'settings.manage')
          && settingId == 'main'
          && request.resource.data.keys().hasOnly(['orgId', 'gradingScale', 'passMark', 'attendanceThreshold', 'weights', 'director',
               'deletedAt', 'deletedBy', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
          && listOf(request.resource.data.gradingScale, 12)
          && request.resource.data.passMark is number && request.resource.data.passMark >= 0 && request.resource.data.passMark <= 100
          && request.resource.data.attendanceThreshold is number && request.resource.data.attendanceThreshold >= 0 && request.resource.data.attendanceThreshold <= 100
          && request.resource.data.weights is map;
        allow delete: if false;
      }

      // One record per student, with the person's id as its id. The admission
      // number is added by a Cloud Function, and "graduated" only by issuing a certificate.
      // A department's names-only class list, for its lecturers (functions/src/rosters.ts).
      match /rosters/{courseId} {
        allow read: if schoolRead() || (canAccessOrg(orgId) && isTrainer() && courseId in myDepartments());
        allow write: if false;
      }

      match /students/{studentId} {
        allow read: if schoolRead();
        allow create, update: if orgWrite(orgId, 'people.write')
          && request.resource.data.keys().hasOnly(['orgId', 'courseId', 'intakeId', 'level', 'status', 'admissionNo', 'sponsors',
               'enrolledOn', 'withdrawnOn', 'graduatedOn', 'deletedAt', 'deletedBy', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
          && existsInOrg('people', studentId)
          && existsInOrg('courses', request.resource.data.courseId)
          && existsInOrg('intakes', request.resource.data.intakeId)
          && shortText(request.resource.data.level, 60)
          && request.resource.data.status in ['applicant', 'enrolled', 'deferred', 'graduated', 'withdrawn']
          && (request.resource.data.status != 'graduated' || (resource != null && resource.data.status == 'graduated'))
          && (resource == null ? (request.resource.data.get('admissionNo', null) == null
                                  || (schoolManage() && shortText(request.resource.data.admissionNo, 40) && request.resource.data.admissionNo.size() >= 1))
                               : (request.resource.data.get('admissionNo', null) == resource.data.get('admissionNo', null)
                                  // The principal corrects a wrong number, alone (Andy, 2026-10-24: Cohort 2 is 2026).
                                  || (schoolManage() && shortText(request.resource.data.admissionNo, 40) && request.resource.data.admissionNo.size() >= 1
                                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['admissionNo', 'updatedAt', 'updatedBy']))))
          && listOf(request.resource.data.get('sponsors', []), 4);
        allow delete: if false;
      }

      // Identity numbers some regulators ask for. Pastor only.
      match /studentPrivate/{studentId} {
        allow read: if canAccessOrg(orgId) && has('pastoral.read');
        allow create, update: if orgWrite(orgId, 'pastoral.read')
          && request.resource.data.keys().hasOnly(['orgId', 'idNumber', 'notes',
               'deletedAt', 'deletedBy', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
          && existsInOrg('students', studentId)
          && shortText(request.resource.data.idNumber, 40) && shortText(request.resource.data.notes, 2000);
        allow delete: if false;
      }

      match /assessments/{assessmentId} {
        allow read: if schoolRead();
        allow create, update: if orgWrite(orgId, 'programs.write')
          && request.resource.data.keys().hasOnly(['orgId', 'courseId', 'unitId', 'type', 'name', 'maxMarks', 'date',
               'deletedAt', 'deletedBy', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
          && existsInOrg('courses', request.resource.data.courseId)
          && shortText(request.resource.data.unitId, 40)
          && request.resource.data.type in ['continuous', 'practical', 'exam']
          && shortText(request.resource.data.name, 120) && request.resource.data.name.size() >= 1
          && request.resource.data.maxMarks is number && request.resource.data.maxMarks > 0 && request.resource.data.maxMarks <= 1000
          && isDate(request.resource.data.date);
        allow delete: if false;
      }

      match /marks/{markId} {
        allow read: if schoolRead();
        allow create, update: if orgWrite(orgId, 'programs.write')
          && request.resource.data.keys().hasOnly(['orgId', 'assessmentId', 'studentId', 'marks',
               'deletedAt', 'deletedBy', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
          && markId == request.resource.data.assessmentId + '_' + request.resource.data.studentId
          && existsInOrg('students', request.resource.data.studentId)
          && existsInOrg('assessments', request.resource.data.assessmentId)
          && request.resource.data.marks is number && request.resource.data.marks >= 0
          && request.resource.data.marks <= getAfter(/databases/$(database)/documents/organizations/$(orgId)/assessments/$(request.resource.data.assessmentId)).data.maxMarks
          && (resource == null || (request.resource.data.assessmentId == resource.data.assessmentId && request.resource.data.studentId == resource.data.studentId));
        allow delete: if false;
      }

      match /feeStructures/{structureId} {
        allow read: if feesRead() || schoolRead();
        allow create, update: if orgWrite(orgId, 'settings.manage')
          && request.resource.data.keys().hasOnly(['orgId', 'courseId', 'intakeId', 'items',
               'deletedAt', 'deletedBy', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
          && structureId == request.resource.data.courseId + '_' + request.resource.data.intakeId
          && existsInOrg('courses', request.resource.data.courseId)
          && existsInOrg('intakes', request.resource.data.intakeId)
          && listOf(request.resource.data.items, 20);
        allow delete: if false;
      }

      match /invoices/{invoiceId} {
        allow read: if feesRead();
        allow create, update: if orgWrite(orgId, 'gifts.write')
          && request.resource.data.keys().hasOnly(['orgId', 'studentId', 'items', 'totalCents', 'dueDate', 'label', 'status',
               'voidReason', 'deletedAt', 'deletedBy', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
          && existsInOrg('students', request.resource.data.studentId)
          && listOf(request.resource.data.items, 20)
          && request.resource.data.totalCents is int && request.resource.data.totalCents >= 0 && request.resource.data.totalCents <= 10000000000
          && (request.resource.data.dueDate == null || isDate(request.resource.data.dueDate))
          && shortText(request.resource.data.label, 80)
          && request.resource.data.status in ['open', 'void']
          && (resource == null
              ? request.resource.data.status == 'open'
              : (request.resource.data.studentId == resource.data.studentId
                 && request.resource.data.totalCents == resource.data.totalCents));
        allow delete: if false;
      }

      // What each student has been billed and has paid. Cloud Functions write it.
      match /feeBalances/{studentId} {
        // The principal sees each student's balance, but no invoices or payments (Andy, 2026-10-25).
        allow read: if feesRead() || (canAccessOrg(orgId) && has('fees.balances'));
        allow write: if false;
      }

      // The certificate register. The serial number and the "graduated" status
      // are added by a Cloud Function when a certificate is issued.
      match /certificates/{certificateId} {
        allow read: if schoolRead();
        allow create: if (orgWrite(orgId, 'settings.manage') || orgWrite(orgId, 'school.manage'))
          && certificateId == request.resource.data.studentId
          && request.resource.data.keys().hasOnly(['orgId', 'studentId', 'courseId', 'issuedOn',
               'deletedAt', 'deletedBy', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
          && existsInOrg('students', request.resource.data.studentId)
          && existsInOrg('courses', request.resource.data.courseId)
          && isDate(request.resource.data.issuedOn);
        allow update, delete: if false;
      }

      // Employment follow-up at 3, 6 and 12 months. A Cloud Function creates each
      // one when a certificate is issued; staff record what the graduate is doing.
      match /outcomes/{outcomeId} {
        allow read: if schoolRead();
        allow update: if orgWrite(orgId, 'people.write')
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'note', 'recordedOn', 'updatedAt', 'updatedBy'])
          && request.resource.data.status in ['employed', 'self_employed', 'studying', 'seeking', 'unreachable']
          && shortText(request.resource.data.note, 500)
          && isDate(request.resource.data.recordedOn);
        allow create, delete: if false;
      }

      // Weekly and monthly school reports (made by a Cloud Function). The director's copy has fees in it.
      match /schoolReports/{reportId} {
        allow read: if canAccessOrg(orgId) && (has('finance.reports') || has('settings.manage'));
        allow write: if false;
      }
      match /schoolReportRequests/{requestId} {
        allow read: if canAccessOrg(orgId) && (has('finance.reports') || has('settings.manage'));
        allow create: if canAccessOrg(orgId) && (has('finance.reports') || has('settings.manage'))
          && request.resource.data.keys().hasOnly(['orgId', 'type', 'from', 'status', 'createdAt', 'createdBy'])
          && request.resource.data.orgId == orgId
          && request.resource.data.type in ['weekly', 'monthly']
          && isDate(request.resource.data.from)
          && request.resource.data.status == 'pending'
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }

      // ---- Freedom Hope Center -------------------------------------------
      // Protecting children comes first. The register is open to staff who see
      // people (names, codes, attendance). Welfare notes, home visits, referrals
      // and safeguarding concerns are pastor-only: staff can raise a concern but
      // cannot open it again. No record anywhere holds a photo.

      function hopeRead() {
        return canAccessOrg(orgId) && (has('people.read') || has('attendance.write'));
      }
      function validConsent(c) {
        return c is map && c.keys().hasOnly(['given', 'date'])
          && (c.given == null || c.given is bool)
          && (c.date == null || isDate(c.date));
      }

      // One record per child, with the person's id as its id. The code (HC-0042) is added by a Cloud Function.
      // Consent can be missing: saving never waits for it.
      match /children/{childId} {
        allow read: if hopeRead();
        allow create, update: if orgWrite(orgId, 'people.write')
          && request.resource.data.keys().hasOnly(['orgId', 'code', 'status', 'enrolledOn', 'exitedOn', 'schoolStatus', 'programmes', 'dateOfBirth', 'school',
               'photoConsent', 'guardianConsent', 'deletedAt', 'deletedBy', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
          && existsInOrg('people', childId)
          && request.resource.data.status in ['active', 'exited']
          && request.resource.data.schoolStatus in ['in_school', 'not_in_school', 'unknown']
          && optionalDate(request.resource.data.get('enrolledOn', null))
          && optionalDate(request.resource.data.get('exitedOn', null))
          && optionalDate(request.resource.data.get('dateOfBirth', null))
          && shortText(request.resource.data.get('school', ''), 120)
          && listOf(request.resource.data.programmes, 8)
          && validConsent(request.resource.data.photoConsent)
          && validConsent(request.resource.data.guardianConsent)
          && (resource == null ? request.resource.data.get('code', null) == null
                               : request.resource.data.get('code', null) == resource.data.get('code', null));
        allow delete: if false;
      }

      // Welfare notes, dietary and health flags, home circumstances. Pastor only.
      match /childPrivate/{childId} {
        allow read: if canAccessOrg(orgId) && has('pastoral.read');
        allow create, update: if orgWrite(orgId, 'pastoral.read')
          && request.resource.data.keys().hasOnly(['orgId', 'welfare', 'health', 'home',
               'deletedAt', 'deletedBy', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
          && existsInOrg('children', childId)
          && shortText(request.resource.data.get('welfare', ''), 4000)
          && shortText(request.resource.data.get('health', ''), 2000)
          && shortText(request.resource.data.get('home', ''), 2000);
        allow delete: if false;
      }

      match /homeVisits/{visitId} {
        allow read: if canAccessOrg(orgId) && has('pastoral.read');
        allow create, update: if orgWrite(orgId, 'pastoral.read')
          && request.resource.data.keys().hasOnly(['orgId', 'childId', 'date', 'note',
               'deletedAt', 'deletedBy', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
          && existsInOrg('children', request.resource.data.childId)
          && isDate(request.resource.data.date)
          && shortText(request.resource.data.note, 3000)
          && (resource == null || request.resource.data.childId == resource.data.childId);
        allow delete: if false;
      }

      match /referrals/{referralId} {
        allow read: if canAccessOrg(orgId) && has('pastoral.read');
        allow create, update: if orgWrite(orgId, 'pastoral.read')
          && request.resource.data.keys().hasOnly(['orgId', 'childId', 'date', 'to', 'reason', 'status', 'outcome',
               'deletedAt', 'deletedBy', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
          && existsInOrg('children', request.resource.data.childId)
          && isDate(request.resource.data.date)
          && shortText(request.resource.data.to, 120) && request.resource.data.to.size() >= 1
          && shortText(request.resource.data.reason, 1000)
          && request.resource.data.status in ['open', 'closed']
          && shortText(request.resource.data.get('outcome', ''), 1000)
          && (resource == null || request.resource.data.childId == resource.data.childId);
        allow delete: if false;
      }

      // A safeguarding concern. Any staff member who can see children may raise one, and
      // from then on only the pastor can read it. The pastor closes it with a note.
      match /safeguardingConcerns/{concernId} {
        allow read: if canAccessOrg(orgId) && has('pastoral.read');
        allow create: if canAccessOrg(orgId) && (has('people.write') || has('attendance.write'))
          && request.resource.data.keys().hasOnly(['orgId', 'childId', 'summary', 'status', 'createdAt', 'createdBy'])
          && request.resource.data.orgId == orgId
          && existsInOrg('children', request.resource.data.childId)
          && shortText(request.resource.data.summary, 4000) && request.resource.data.summary.size() >= 1
          && request.resource.data.status == 'open'
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt == request.time;
        allow update: if canAccessOrg(orgId) && has('pastoral.read')
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'closingNote', 'closedAt', 'closedBy'])
          && request.resource.data.status in ['open', 'closed']
          && shortText(request.resource.data.get('closingNote', ''), 2000)
          && (request.resource.data.status == 'open' || (request.resource.data.closedBy == request.auth.uid && request.resource.data.closedAt == request.time));
        allow delete: if false;
      }

      // Anything that exports child data needs the pastor's approval, and is logged (every
      // write here goes into the activity log). Staff ask; the pastor decides; the person who
      // asked can then download once.
      match /childExports/{exportId} {
        allow read: if canAccessOrg(orgId) && (has('data.export') || resource.data.createdBy == request.auth.uid);
        allow create: if canAccessOrg(orgId) && (has('people.read') || has('data.export'))
          && request.resource.data.keys().hasOnly(['orgId', 'scope', 'reason', 'status', 'createdAt', 'createdBy', 'decidedBy', 'decidedAt'])
          && request.resource.data.orgId == orgId
          && request.resource.data.scope in ['register', 'attendance']
          && shortText(request.resource.data.reason, 300) && request.resource.data.reason.size() >= 3
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt == request.time
          && (request.resource.data.status == 'pending'
              || (request.resource.data.status == 'approved' && has('data.export')
                  && request.resource.data.decidedBy == request.auth.uid && request.resource.data.decidedAt == request.time));
        allow update: if canAccessOrg(orgId)
          && ((has('data.export') && resource.data.status == 'pending'
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'decidedBy', 'decidedAt'])
                && request.resource.data.status in ['approved', 'denied']
                && request.resource.data.decidedBy == request.auth.uid && request.resource.data.decidedAt == request.time)
              || (resource.data.createdBy == request.auth.uid && resource.data.status == 'approved'
                  && resource.data.get('downloadedAt', null) == null
                  && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['downloadedAt'])
                  && request.resource.data.downloadedAt == request.time));
        allow delete: if false;
      }

      // Weekly (pastor: names by code) and monthly (counts only) Hope Center reports, made by a Cloud Function.
      match /hopeReports/{reportId} {
        allow read: if canAccessOrg(orgId)
          && (has('pastoral.read') || (resource.data.audience == 'counts' && (has('people.read') || has('finance.reports'))));
        allow write: if false;
      }
      match /hopeReportRequests/{requestId} {
        allow read: if canAccessOrg(orgId) && (has('people.read') || has('pastoral.read'));
        allow create: if canAccessOrg(orgId)
          && request.resource.data.keys().hasOnly(['orgId', 'type', 'from', 'status', 'createdAt', 'createdBy'])
          && request.resource.data.orgId == orgId
          && request.resource.data.type in ['weekly', 'monthly']
          && (request.resource.data.type == 'monthly' ? has('people.read') : has('pastoral.read'))
          && isDate(request.resource.data.from)
          && request.resource.data.status == 'pending'
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
      // "Check now" for children who have missed three sessions.
      match /absenceCheckRequests/{requestId} {
        allow read: if canAccessOrg(orgId) && has('followups.manage');
        allow create: if canAccessOrg(orgId) && has('followups.manage')
          && request.resource.data.keys().hasOnly(['orgId', 'status', 'createdAt', 'createdBy'])
          && request.resource.data.orgId == orgId
          && request.resource.data.status == 'pending'
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }

      // "Download everything", one person's export and erasing one person. A Cloud
      // Function checks the pastor again, does the erasing, logs it and marks it done.
      // ---- ADIA petty cash ---------------------------------------------------
      // Petty cash for ADIA Training Centre, Freedom Hope Center and Freedom Church, each organization on its own.
      // Submitted by the requester, checked by the accountant, then final approval by a board member.
      // Nobody acts on their own request, and the final approver is never the person who checked it.
      // The pastor (users.manage) holds every petty cash role, as accounts made before petty cash existed
      // do not carry the new permissions. The number (ADIA-00015) is written by a Cloud Function.
      function pc(permission) {
        return canAccessOrg(orgId) && (has(permission) || has('users.manage'));
      }
      function pcAny() {
        return pc('pettycash.request') || pc('pettycash.check') || pc('pettycash.approve');
      }
      function pcStamp(a) {
        return a.keys().hasOnly(['uid', 'name', 'role', 'at'])
          && a.uid == request.auth.uid && a.at == request.time
          && shortText(a.name, 120) && shortText(a.role, 60);
      }
      // Who may sign a requisition: the accountant, the board members and the signing stakeholders.
      // A month two stakeholders have closed: nothing in it changes (Andy, 2026-10-24).
      function pcMonthOpen(month) {
        return !exists(/databases/$(database)/documents/organizations/$(orgId)/pettyMonths/$(month))
          || get(/databases/$(database)/documents/organizations/$(orgId)/pettyMonths/$(month)).data.status != 'closed';
      }
      // Who was paid and the M-Pesa code (10 letters and digits); both optional.
      function pcPaymentFields(d) {
        return (d.get('payee', null) == null || shortText(d.payee, 120))
          && (d.get('mpesaCode', null) == null || (d.mpesaCode is string && d.mpesaCode.matches('^[A-Z0-9]{10}$')));
      }
      function pcSigner() {
        return pc('pettycash.check') || pc('pettycash.approve') || pc('pettycash.authorize');
      }
      // The title under a signature is the one on the signer's account; only the accountant signs as Accountant.
      function pcSignature(s) {
        return s.keys().hasOnly(['name', 'role', 'at']) && s.at == request.time && shortText(s.name, 120) && shortText(s.role, 60)
          && (me().get('pettyTitle', '') != '' ? s.role == me().pettyTitle : s.role != 'Accountant');
      }
      function pcStep(fields) {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields.concat(['updatedAt', 'updatedBy']))
          && request.resource.data.updatedBy == request.auth.uid && request.resource.data.updatedAt == request.time
          && resource.data.requesterId != request.auth.uid
          && resource.data.deletedAt == null;
      }

      match /pettyCash/{reqId} {
        allow read: if pc('pettycash.check') || pc('pettycash.approve') || pc('pettycash.authorize')
          || (pc('pettycash.request') && resource.data.requesterId == request.auth.uid);
        // Only the signatories (pettycash.request) and the pastor raise requests.
        allow create: if pc('pettycash.request') && stampedCreate() && freshRecord()
          && request.resource.data.keys().hasOnly(['orgId', 'number', 'requesterId', 'requesterName', 'category', 'categoryNote', 'items',
               'totalCents', 'month', 'status', 'checked', 'approved', 'rejection', 'signatures', 'payee', 'mpesaCode',
               'deletedAt', 'deletedBy', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
          && request.resource.data.orgId == orgId
          && pcPaymentFields(request.resource.data) && pcMonthOpen(request.resource.data.month)
          && request.resource.data.number == null
          && request.resource.data.requesterId == request.auth.uid
          && shortText(request.resource.data.requesterName, 120)
          && request.resource.data.category in ['Training materials', 'Office & supplies', 'Staff Payments', 'Transport', 'Repairs & maintenance', 'Utilities', 'Other',
               "Children's needs", 'Programmes & activities', 'Office & supplies', 'Ministry & programmes', 'Hospitality']
          && request.resource.data.items is list && request.resource.data.items.size() >= 1 && request.resource.data.items.size() <= 30
          && request.resource.data.totalCents is int && request.resource.data.totalCents > 0 && request.resource.data.totalCents <= 100000000000
          && request.resource.data.month is string && request.resource.data.month.matches('^[0-9]{4}-[0-9]{2}$')
          && request.resource.data.status == 'submitted'
          && request.resource.data.checked == null && request.resource.data.approved == null
          && request.resource.data.rejection == null
          && request.resource.data.get('signatures', {}).size() == 0
          // "Other" must say what it is for; other categories carry no note.
          && (request.resource.data.category == 'Other'
               ? shortText(request.resource.data.get('categoryNote', ''), 120) && request.resource.data.categoryNote.size() >= 1
               : request.resource.data.get('categoryNote', null) == null);
        // A turn-down at a step, with a reason.
        function pcRejection() {
          let r = request.resource.data.rejection;
          return request.resource.data.status == 'rejected'
            && r.keys().hasOnly(['uid', 'name', 'reason', 'at']) && r.uid == request.auth.uid && r.at == request.time
            && shortText(r.name, 120) && shortText(r.reason, 500) && r.reason.size() >= 1;
        }
        // Signing goes through signWithPin on the server, which checks the PIN, the Director's limit and
        // that there is enough cash (Andy, 2026-10-24). Here a signer may only turn a waiting request down.
        function pcRejectFlow() {
          return (resource.data.status == 'submitted' || (resource.data.status == 'checked' && !('signatures' in resource.data)))
            && pcSigner() && pcStep(['status', 'rejection']) && pcRejection();
        }
        // The requester or a signer adds or corrects who was paid and the M-Pesa code, until the month is closed.
        function pcPaymentEdit() {
          return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['payee', 'mpesaCode', 'updatedAt', 'updatedBy'])
            && request.resource.data.updatedBy == request.auth.uid && request.resource.data.updatedAt == request.time
            && (resource.data.requesterId == request.auth.uid || pcSigner())
            && resource.data.status != 'rejected' && pcPaymentFields(request.resource.data);
        }
        allow update: if resource.data.deletedAt == null && pcMonthOpen(resource.data.month)
            && (pcPaymentEdit() || (resource.data.requesterId != request.auth.uid && pcRejectFlow()));
        allow delete: if false;
      }

      // Receipts for a requisition: a small record (name, type, size) and, separately, the file itself, so
      // the list of receipts loads quickly. Seen and added by whoever may see the requisition; removed
      // only through the bin, with two stakeholders.
      function pcSeesRequest(reqId) {
        return pc('pettycash.check') || pc('pettycash.approve') || pc('pettycash.authorize')
          || (pc('pettycash.request')
              && get(/databases/$(database)/documents/organizations/$(orgId)/pettyCash/$(reqId)).data.requesterId == request.auth.uid);
      }
      function pcReceiptTypes() {
        return '(image/(jpeg|png|gif|webp|heic|heif|tiff|bmp)|application/(pdf|msword|rtf|vnd[.]ms-excel|vnd[.]openxmlformats-officedocument[.](wordprocessingml[.]document|spreadsheetml[.]sheet)|vnd[.]oasis[.]opendocument[.](text|spreadsheet))|text/(csv|plain))';
      }
      function pcRequestOpen(reqId) {
        return exists(/databases/$(database)/documents/organizations/$(orgId)/pettyCash/$(reqId))
          && get(/databases/$(database)/documents/organizations/$(orgId)/pettyCash/$(reqId)).data.status != 'rejected'
          && pcMonthOpen(get(/databases/$(database)/documents/organizations/$(orgId)/pettyCash/$(reqId)).data.month);
      }
      match /pettyReceipts/{receiptId} {
        allow read: if pcSeesRequest(resource.data.reqId);
        allow create: if stampedCreate() && freshRecord()
          && request.resource.data.keys().hasOnly(['orgId', 'reqId', 'name', 'type', 'size', 'uploadedByName', 'itemIndex',
               'deletedAt', 'deletedBy', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
          && request.resource.data.orgId == orgId
          && request.resource.data.reqId is string && pcRequestOpen(request.resource.data.reqId)
          && pcSeesRequest(request.resource.data.reqId)
          && shortText(request.resource.data.name, 200) && shortText(request.resource.data.type, 100)
          && request.resource.data.size is int && request.resource.data.size > 0 && request.resource.data.size <= 10000000
          && request.resource.data.type.matches(pcReceiptTypes())
          && shortText(request.resource.data.uploadedByName, 120)
          && (!('itemIndex' in request.resource.data) || (request.resource.data.itemIndex is int
               && request.resource.data.itemIndex >= 0 && request.resource.data.itemIndex < 50));
        // Deleting goes through the bin (pettyBinSign), which needs two stakeholders.
        allow update, delete: if false;
      }
      // The file itself: older receipts hold it in `data`; newer ones are split into `parts` saved as
      // pettyReceiptParts/{receiptId}_{n}, so files of up to 10 MB fit.
      match /pettyReceiptFiles/{receiptId} {
        allow read: if pcSeesRequest(resource.data.reqId);
        allow create: if stampedCreate() && freshRecord()
          && request.resource.data.keys().hasOnly(['orgId', 'reqId', 'parts', 'deletedAt', 'deletedBy', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
          && request.resource.data.orgId == orgId
          && request.resource.data.reqId is string && pcRequestOpen(request.resource.data.reqId)
          && pcSeesRequest(request.resource.data.reqId)
          && request.resource.data.parts is int && request.resource.data.parts >= 1 && request.resource.data.parts <= 16;
        allow update, delete: if false;
      }
      match /pettyReceiptParts/{partId} {
        allow read: if pcSeesRequest(resource.data.reqId);
        allow create: if request.resource.data.keys().hasOnly(['orgId', 'reqId', 'receiptId', 'index', 'data', 'createdAt', 'createdBy'])
          && request.resource.data.createdBy == request.auth.uid && request.resource.data.createdAt == request.time
          && request.resource.data.orgId == orgId
          && request.resource.data.reqId is string && pcRequestOpen(request.resource.data.reqId)
          && pcSeesRequest(request.resource.data.reqId)
          && request.resource.data.receiptId is string && request.resource.data.index is int
          && request.resource.data.index >= 0 && request.resource.data.index < 16
          && partId == request.resource.data.receiptId + '_' + string(request.resource.data.index)
          && request.resource.data.data is string && request.resource.data.data.size() <= 900000
          && (request.resource.data.index != 0 || request.resource.data.data.matches('^data:' + pcReceiptTypes() + ';base64,.*'));
        allow update, delete: if false;
      }

      // The bin: a record per deleted (or once deleted) entry, with who asked, who signed and why.
      // Written only by pettyBinSign; read by everyone with petty cash access here.
      match /pettyBin/{entryId} {
        allow read: if pcAny() || pc('pettycash.authorize');
        allow write: if false;
      }

      // Month-end close records, written by closePettyMonth / reopenPettyMonth only.
      match /pettyMonths/{month} {
        allow read: if pcAny() || pc('pettycash.authorize');
        allow write: if false;
      }

      // How much of the budget each category may use. Set by the signing stakeholders.
      match /pettySettings/{docId} {
        allow read: if pcAny() || pc('pettycash.authorize');
        allow write: if docId == 'budget' && pc('pettycash.authorize')
          && request.resource.data.keys().hasOnly(['orgId', 'allocations', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
          && request.resource.data.orgId == orgId
          && request.resource.data.allocations is map && request.resource.data.allocations.size() <= 12
          && request.resource.data.updatedBy == request.auth.uid && request.resource.data.updatedAt == request.time;
      }

      // Money added to petty cash (a top-up) or the budget started again from zero (a reset). Any three
      // stakeholders holding pettycash.authorize must sign, each from their own account; the third
      // signature completes it.
      function fundSignature(s) {
        return s.keys().hasOnly(['name', 'at']) && s.at == request.time && shortText(s.name, 120);
      }
      match /pettyFunds/{fundId} {
        allow read: if pcAny() || pc('pettycash.authorize');
        allow create: if pc('pettycash.authorize') && stampedCreate() && freshRecord()
          && request.resource.data.keys().hasOnly(['orgId', 'kind', 'amountCents', 'signatures', 'status', 'doneAt',
               'deletedAt', 'deletedBy', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
          && request.resource.data.orgId == orgId
          && request.resource.data.kind == 'topup'
          && request.resource.data.amountCents is int
          && (request.resource.data.kind == 'topup'
               ? request.resource.data.amountCents > 0 && request.resource.data.amountCents <= 100000000000
               : request.resource.data.amountCents == 0)
          && request.resource.data.signatures.keys().hasOnly([request.auth.uid])
          && request.resource.data.signatures.size() == 1
          && fundSignature(request.resource.data.signatures[request.auth.uid])
          && request.resource.data.status == 'collecting' && request.resource.data.doneAt == null;
        // Deleting goes through the bin (pettyBinSign), which needs two stakeholders.
        allow update: if (pc('pettycash.authorize') && stampedUpdate()
          && resource.data.status == 'collecting' && resource.data.deletedAt == null
          && (
            // A stakeholder who has not signed yet adds their signature.
            (resource.data.kind == 'topup'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['signatures', 'status', 'doneAt', 'updatedAt', 'updatedBy'])
              && !(request.auth.uid in resource.data.signatures)
              && request.resource.data.signatures.diff(resource.data.signatures).affectedKeys().hasOnly([request.auth.uid])
              && request.auth.uid in request.resource.data.signatures
              && fundSignature(request.resource.data.signatures[request.auth.uid])
              && (request.resource.data.signatures.size() >= 2
                   ? request.resource.data.status == 'done' && request.resource.data.doneAt == request.time
                   : request.resource.data.status == 'collecting' && request.resource.data.doneAt == null))
            // Whoever started it may cancel it before it is complete.
            || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'updatedBy'])
              && request.resource.data.status == 'cancelled' && resource.data.createdBy == request.auth.uid)
          ));
        allow delete: if false;
      }

      // ADIA payroll. Staff pay details and pay runs are seen only by those who keep or approve the payroll
      // (and the pastor). A pay run is approved by someone other than whoever last prepared it, and is then locked.
      function pay(permission) {
        return canAccessOrg(orgId) && (has(permission) || has('users.manage'));
      }
      function payAny() {
        return pay('payroll.manage') || pay('payroll.approve');
      }
      function payItems(v) {
        return v is list && v.size() <= 20;
      }
      match /payrollStaff/{staffId} {
        allow read: if payAny();
        allow create, update: if pay('payroll.manage')
          && request.resource.data.keys().hasOnly(['orgId', 'name', 'staffNo', 'jobTitle', 'kraPin', 'nssfNo', 'shifNo',
               'paymentDetails', 'basicCents', 'allowances', 'deductions', 'active', 'idNo', 'phone', 'email', 'loans',
               'deletedAt', 'deletedBy', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
          && request.resource.data.orgId == orgId
          && shortText(request.resource.data.name, 120) && request.resource.data.name.size() >= 1
          && shortText(request.resource.data.staffNo, 40) && shortText(request.resource.data.jobTitle, 80)
          && shortText(request.resource.data.kraPin, 20) && shortText(request.resource.data.nssfNo, 30)
          && shortText(request.resource.data.shifNo, 30) && shortText(request.resource.data.paymentDetails, 200)
          && request.resource.data.basicCents is int && request.resource.data.basicCents >= 0 && request.resource.data.basicCents <= 100000000000
          && payItems(request.resource.data.allowances) && payItems(request.resource.data.deductions)
          && shortText(request.resource.data.get('idNo', ''), 20) && shortText(request.resource.data.get('phone', ''), 20)
          && shortText(request.resource.data.get('email', ''), 120) && payItems(request.resource.data.get('loans', []))
          && request.resource.data.active is bool
          && (resource == null ? stampedCreate() && freshRecord() : stampedUpdate() && validSoftDelete());
        allow delete: if false;
      }
      match /payrollRuns/{month} {
        allow read: if payAny();
        allow create: if pay('payroll.manage') && month.matches('^[0-9]{4}-[0-9]{2}$') && stampedCreate() && freshRecord()
          && request.resource.data.keys().hasOnly(['orgId', 'month', 'status', 'lines', 'totals', 'rates', 'preparedBy', 'preparedByName', 'approved', 'adjustments', 'reviewed',
               'deletedAt', 'deletedBy', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
          && request.resource.data.orgId == orgId && request.resource.data.month == month
          && request.resource.data.status == 'draft' && request.resource.data.approved == null
          && request.resource.data.get('reviewed', null) == null && request.resource.data.get('adjustments', {}) is map
          && request.resource.data.preparedBy == request.auth.uid && shortText(request.resource.data.preparedByName, 120)
          && request.resource.data.lines is list && request.resource.data.lines.size() <= 300
          && request.resource.data.totals is map && request.resource.data.rates is map;
        allow update: if resource.data.status == 'draft' && stampedUpdate() && (
          // Prepared again from the current staff details, while still a draft.
          (pay('payroll.manage')
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lines', 'totals', 'rates', 'preparedBy', 'preparedByName', 'adjustments', 'reviewed', 'updatedAt', 'updatedBy'])
            && request.resource.data.get('reviewed', null) == null && request.resource.data.get('adjustments', {}) is map
            && request.resource.data.preparedBy == request.auth.uid && shortText(request.resource.data.preparedByName, 120)
            && request.resource.data.lines is list && request.resource.data.lines.size() <= 300)
          // Checked and signed as reviewed by someone who did not prepare it (preparing again clears it).
          || (payAny() && resource.data.preparedBy != request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reviewed', 'updatedAt', 'updatedBy'])
            && request.resource.data.reviewed.keys().hasOnly(['uid', 'name', 'at'])
            && request.resource.data.reviewed.uid == request.auth.uid && request.resource.data.reviewed.at == request.time
            && shortText(request.resource.data.reviewed.name, 120))
          // Approved by someone who did not prepare it; it is then locked.
          || (pay('payroll.approve') && resource.data.preparedBy != request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'approved', 'updatedAt', 'updatedBy'])
            && request.resource.data.status == 'approved'
            && request.resource.data.approved.keys().hasOnly(['uid', 'name', 'at'])
            && request.resource.data.approved.uid == request.auth.uid && request.resource.data.approved.at == request.time
            && shortText(request.resource.data.approved.name, 120)));
        allow delete: if false;
      }
      match /payrollSettings/{settingId} {
        allow read: if payAny();
        allow create, update: if pay('payroll.approve') && settingId == 'rates'
          && request.resource.data.keys().hasOnly(['orgId', 'nssfRate', 'nssfUpperLimitCents', 'shifRate', 'shifMinimumCents', 'housingRate',
               'personalReliefCents', 'deletedAt', 'deletedBy', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
          && request.resource.data.orgId == orgId
          && request.resource.data.nssfRate is number && request.resource.data.nssfRate >= 0 && request.resource.data.nssfRate <= 0.5
          && request.resource.data.shifRate is number && request.resource.data.shifRate >= 0 && request.resource.data.shifRate <= 0.5
          && request.resource.data.housingRate is number && request.resource.data.housingRate >= 0 && request.resource.data.housingRate <= 0.5
          && request.resource.data.nssfUpperLimitCents is int && request.resource.data.nssfUpperLimitCents >= 0
          && request.resource.data.shifMinimumCents is int && request.resource.data.shifMinimumCents >= 0
          && request.resource.data.personalReliefCents is int && request.resource.data.personalReliefCents >= 0
          && (resource == null ? stampedCreate() && freshRecord() : stampedUpdate() && validSoftDelete());
        allow delete: if false;
      }

      // ADIA exam records. A trainer (exams.mark) sees and keys in only their own marks sheets, and only while
      // they are drafts; submitting locks a sheet. The principal (exams.manage, and the pastor) sees every sheet,
      // may change marks on a locked sheet, unlocks it, and keeps the remarks, attendance and grading. Every change
      // the principal makes is written to the exam log by the app.
      function ex(permission) {
        return canAccessOrg(orgId) && (has(permission) || has('users.manage'));
      }
      function examWeights(w) {
        return w is map && w.keys().hasOnly(['cat1', 'cat2', 'cat3', 'final']) && w.keys().hasAll(['cat1', 'cat2', 'cat3', 'final']);
      }
      function weightValues(w) {
        return paperWeight(w.cat1) && paperWeight(w.cat2) && paperWeight(w.cat3) && paperWeight(w.final);
      }
      function paperWeight(p) {
        return p is map && p.max is number && p.max > 0 && p.max <= 1000 && p.wt is number && p.wt >= 0 && p.wt <= 100;
      }
      function markMap(d, field) {
        return !(field in d) || (d[field] is map && d[field].size() <= 400);
      }
      // A paper the trainer sent is locked: only the principal unlocks it (Andy, 2026-10-25). The trainer keys in
      // each paper, sets the percentages until the first paper is sent, sends papers (they lock), and sends the
      // Final to submit. After that they can only ask to change something.
      function trainerSheetUpdate(b, a) {
        let changed = a.diff(b).affectedKeys();
        let lb = b.get('locked', {});
        let la = a.get('locked', {});
        return b.status == 'draft'
          ? changed.hasOnly(['cat1Marks', 'cat2Marks', 'cat3Marks', 'finalMarks', 'resitMarks', 'locked', 'weights', 'changeRequest', 'status', 'submittedAt', 'updatedAt', 'updatedBy'])
            && (lb.get('cat1', false) != true || (la.get('cat1', false) == true && !changed.hasAny(['cat1Marks'])))
            && (lb.get('cat2', false) != true || (la.get('cat2', false) == true && !changed.hasAny(['cat2Marks'])))
            && (lb.get('cat3', false) != true || (la.get('cat3', false) == true && !changed.hasAny(['cat3Marks'])))
            && (lb.get('final', false) != true || (la.get('final', false) == true && !changed.hasAny(['finalMarks', 'resitMarks'])))
            && (!changed.hasAny(['weights']) || (!lb.values().hasAny([true]) && weightValues(a.weights)))
            && (a.status == 'draft' || (a.status == 'submitted' && a.submittedAt == request.time && la.get('final', false) == true))
          : b.status == 'submitted' && changed.hasOnly(['changeRequest', 'updatedAt', 'updatedBy']);
      }
      function examSheetFields(d) {
        return d.keys().hasOnly(['orgId', 'cohort', 'courseId', 'ownerUid', 'ownerName', 'courseName', 'teacherName', 'weights', 'status',
               'submittedAt', 'marks', 'semester', 'approvedAt', 'approvedByName', 'returnNote',
               'cat1Marks', 'cat2Marks', 'cat3Marks', 'finalMarks', 'resitMarks', 'locked', 'changeRequest', 'notified',
               'deletedAt', 'deletedBy', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
          && markMap(d, 'cat1Marks') && markMap(d, 'cat2Marks') && markMap(d, 'cat3Marks') && markMap(d, 'finalMarks') && markMap(d, 'resitMarks')
          && (!('locked' in d) || (d.locked is map && d.locked.keys().hasOnly(['cat1', 'cat2', 'cat3', 'final'])))
          && (!('changeRequest' in d) || d.changeRequest == null
              || (d.changeRequest is map && d.changeRequest.keys().hasOnly(['component', 'reason', 'byName'])
                  && d.changeRequest.component in ['cat1', 'cat2', 'cat3', 'final'] && shortText(d.changeRequest.reason, 300) && shortText(d.changeRequest.byName, 120)))
          && d.orgId == orgId && shortText(d.cohort, 80) && d.cohort.size() >= 1 && d.ownerUid is string
          && (d.courseId == null || shortText(d.courseId, 80))
          && shortText(d.courseName, 120) && shortText(d.teacherName, 120) && shortText(d.ownerName, 120)
          && examWeights(d.weights) && d.marks is map && d.marks.size() <= 400
          && d.status in ['draft', 'submitted', 'approved']
          && (!('semester' in d) || d.semester == null || d.semester in [1, 2])
          && (!('returnNote' in d) || d.returnNote == null || shortText(d.returnNote, 300))
          && (!('approvedByName' in d) || d.approvedByName == null || shortText(d.approvedByName, 120));
      }
      // The principal sets up every course and gives it to a trainer (Andy, 2026-10-24). The trainer only keys
      // in marks while marking, then submits; the principal approves (final) or sends it back.
      match /examSheets/{sheetId} {
        allow read: if ex('exams.manage') || (ex('exams.mark') && resource.data.ownerUid == request.auth.uid);
        allow create: if examSheetFields(request.resource.data) && stampedCreate() && freshRecord()
          && request.resource.data.status == 'draft' && request.resource.data.submittedAt == null
          && weightValues(request.resource.data.weights) && ex('exams.manage') && !cohortClosed(request.resource.data.cohort);
        allow update: if examSheetFields(request.resource.data) && stampedUpdate() && validSoftDelete() && !cohortClosed(resource.data.cohort)
          && (ex('exams.manage')
              ? request.resource.data.diff(resource.data).affectedKeys().hasOnly(['courseName', 'teacherName', 'ownerUid', 'ownerName', 'weights', 'marks', 'semester', 'status',
                   'submittedAt', 'approvedAt', 'approvedByName', 'returnNote', 'cat1Marks', 'cat2Marks', 'cat3Marks', 'finalMarks', 'resitMarks', 'locked', 'changeRequest',
                   'deletedAt', 'deletedBy', 'updatedAt', 'updatedBy'])
                && (request.resource.data.status == resource.data.status
                    || (request.resource.data.status == 'submitted' && request.resource.data.submittedAt == request.time)
                    || (request.resource.data.status == 'approved' && request.resource.data.approvedAt == request.time)
                    || request.resource.data.status == 'draft')
              : ex('exams.mark') && resource.data.ownerUid == request.auth.uid && trainerSheetUpdate(resource.data, request.resource.data));
        allow delete: if false;
      }
      // Semester results from Excel (Andy, 2026-10-24): one student's past results for one cohort, kept by
      // the principal only; every save and change is written to the exam log by the app.
      function examScore(v) {
        return v is map && v.keys().hasOnly(['points', 'grade']) && v.points is number && v.points >= 0 && v.points <= 100
          && (v.grade == null || shortText(v.grade, 40));
      }
      // A lecturer types in past results for their own department's students (Andy, 2026-10-28). They can
      // change only what they typed: results the principal uploaded stay as they are.
      function trainerResult() {
        let d = request.resource.data;
        return isTrainer() && canAccessOrg(orgId) && d.courseId in myDepartments()
          && get(/databases/$(database)/documents/organizations/$(orgId)/students/$(d.studentId)).data.courseId == d.courseId
          && d.printed == null
          && (resource == null || (resource.data.createdBy == request.auth.uid && resource.data.courseId == d.courseId));
      }
      match /examResults/{resultId} {
        allow read: if ex('exams.manage') || (isTrainer() && canAccessOrg(orgId) && resource.data.courseId in myDepartments());
        allow create, update: if (ex('exams.manage') || trainerResult())
          && request.resource.data.keys().hasOnly(['orgId', 'cohort', 'studentId', 'admissionNo', 'studentName', 'courseId', 'semesters', 'printed', 'notes',
               'deletedAt', 'deletedBy', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
          && request.resource.data.orgId == orgId && shortText(request.resource.data.cohort, 80) && request.resource.data.cohort.size() >= 1
          && shortText(request.resource.data.studentId, 128) && resultId.matches('^' + request.resource.data.studentId + '_.+')
          && shortText(request.resource.data.admissionNo, 80) && shortText(request.resource.data.studentName, 160)
          && (request.resource.data.courseId == null || shortText(request.resource.data.courseId, 80))
          && request.resource.data.semesters is map && request.resource.data.semesters.keys().hasOnly(['1', '2'])
          && (!('1' in request.resource.data.semesters) || examScore(request.resource.data.semesters['1']))
          && (!('2' in request.resource.data.semesters) || examScore(request.resource.data.semesters['2']))
          && (request.resource.data.printed == null || examScore(request.resource.data.printed))
          && request.resource.data.notes is list && request.resource.data.notes.size() <= 20
          && (resource == null ? stampedCreate() && freshRecord() : stampedUpdate() && validSoftDelete());
        allow delete: if false;
      }
      // Each cohort's graduation date, and whether it has graduated and closed (Andy, 2026-10-25): a closed
      // cohort's marks are read only. Only the principal, an admin, Andy or Doreen reopen it, and only with
      // their password typed again in the last five minutes.
      function cohortKey(name) {
        return name.replace('[^A-Za-z0-9]+', '-').replace('^-|-$', '');
      }
      function cohortClosed(name) {
        let p = /databases/$(database)/documents/organizations/$(orgId)/examCohorts/$(cohortKey(name));
        return exists(p) && get(p).data.closed == true;
      }
      function recentSignIn() {
        return request.auth.token.auth_time is int && request.time.toMillis() - request.auth.token.auth_time * 1000 < 300000;
      }
      // When each paper's marks are due (Andy, 2026-10-25).
      function examDeadlines(d) {
        return d is map && d.keys().hasOnly(['cat1', 'cat2', 'cat3', 'final'])
          && (!('cat1' in d) || isDate(d.cat1)) && (!('cat2' in d) || isDate(d.cat2))
          && (!('cat3' in d) || isDate(d.cat3)) && (!('final' in d) || isDate(d.final));
      }
      match /examCohorts/{key} {
        allow read: if ex('exams.mark') || schoolRead();
        allow create, update: if ex('exams.manage')
          && request.resource.data.keys().hasOnly(['orgId', 'cohort', 'graduationDate', 'closed', 'closedAt', 'closedByName', 'reopenedAt', 'reopenedByName', 'deadlines',
               'deletedAt', 'deletedBy', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
          && (!('deadlines' in request.resource.data) || examDeadlines(request.resource.data.deadlines))
          && request.resource.data.orgId == orgId && shortText(request.resource.data.cohort, 80) && request.resource.data.cohort.size() >= 1
          && key == cohortKey(request.resource.data.cohort)
          && (request.resource.data.graduationDate == null || isDate(request.resource.data.graduationDate))
          && request.resource.data.closed is bool
          && (resource == null ? stampedCreate() && freshRecord() : stampedUpdate() && validSoftDelete() && request.resource.data.cohort == resource.data.cohort)
          && (resource == null || resource.data.closed != true || recentSignIn());
        allow delete: if false;
      }
      match /examMeta/{cohortKey} {
        allow read: if ex('exams.manage');
        allow create, update: if ex('exams.manage')
          && request.resource.data.keys().hasOnly(['orgId', 'cohort', 'remarks', 'attendance', 'deletedAt', 'deletedBy', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
          && request.resource.data.orgId == orgId && shortText(request.resource.data.cohort, 80)
          && request.resource.data.remarks is map && request.resource.data.attendance is map
          && (resource == null ? stampedCreate() && freshRecord() : stampedUpdate() && validSoftDelete());
        allow delete: if false;
      }
      match /examSettings/{settingId} {
        allow read: if ex('exams.manage') || ex('exams.mark');
        allow create, update: if ex('exams.manage') && settingId == 'main'
          && request.resource.data.keys().hasOnly(['orgId', 'passMark', 'bands', 'principalName', 'principalTitle', 'directorName', 'directorTitle', 'weights', 'courseList', 'minAttendance',
               'deletedAt', 'deletedBy', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
          && (!('minAttendance' in request.resource.data) || request.resource.data.minAttendance == null
              || (request.resource.data.minAttendance is number && request.resource.data.minAttendance >= 0 && request.resource.data.minAttendance <= 100))
          && (!('courseList' in request.resource.data) || listOf(request.resource.data.courseList, 400))
          && (!('weights' in request.resource.data) || examWeights(request.resource.data.weights))
          && request.resource.data.orgId == orgId
          && request.resource.data.passMark is number && request.resource.data.passMark >= 0 && request.resource.data.passMark <= 100
          && request.resource.data.bands is list && request.resource.data.bands.size() >= 1 && request.resource.data.bands.size() <= 10
          && shortText(request.resource.data.principalName, 120) && shortText(request.resource.data.principalTitle, 60)
          && shortText(request.resource.data.directorName, 120) && shortText(request.resource.data.directorTitle, 60)
          && (resource == null ? stampedCreate() && freshRecord() : stampedUpdate() && validSoftDelete());
        allow delete: if false;
      }
      match /examLog/{entryId} {
        allow read: if ex('exams.manage');
        allow create: if ex('exams.manage')
          && request.resource.data.keys().hasOnly(['orgId', 'action', 'cohort', 'sheetId', 'detail', 'byUid', 'byName', 'at'])
          && request.resource.data.orgId == orgId && request.resource.data.byUid == request.auth.uid && request.resource.data.at == request.time
          && shortText(request.resource.data.action, 40) && shortText(request.resource.data.cohort, 80)
          && shortText(request.resource.data.detail, 500) && shortText(request.resource.data.byName, 120)
          && (request.resource.data.sheetId == null || shortText(request.resource.data.sheetId, 80));
        allow update, delete: if false;
      }

      match /dataRequests/{requestId} {
        allow read: if canAccessOrg(orgId) && has('data.export');
        allow create: if canAccessOrg(orgId) && has('data.export')
          && request.resource.data.keys().hasOnly(['orgId', 'kind', 'personId', 'status', 'createdAt', 'createdBy'])
          && request.resource.data.orgId == orgId
          && request.resource.data.kind in ['export_all', 'export_person', 'erase_person', 'reset_training']
          && (request.resource.data.kind == 'reset_training' ? orgId == 'training' : true)
          && (request.resource.data.kind in ['export_all', 'reset_training']
              ? request.resource.data.personId == null
              : (request.resource.data.personId is string && existsInOrg('people', request.resource.data.personId)))
          && request.resource.data.status == 'pending'
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
    }

    // Emails waiting to be sent by the Trigger Email extension. Server only.
    match /mail/{mailId} {
      allow read, write: if false;
    }

    // Combined view across every organization, for users who can see them all.
    match /{path=**}/people/{personId} {
      allow read: if hasAllOrgs() && has('people.read');
    }

    // ---- Audit log --------------------------------------------------------

    match /auditLog/{entryId} {
      allow read: if has('audit.read');
      allow write: if false; // written only by Cloud Functions
    }
  }
}
