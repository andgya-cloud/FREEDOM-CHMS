# Copy to .env.local and fill in from Firebase console > Project settings > Your apps.
# These identify the Firebase project; they are not secrets, but keep them out of git anyway.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Set to "true" to talk to the local emulators instead of the live project.
VITE_USE_EMULATORS=true
