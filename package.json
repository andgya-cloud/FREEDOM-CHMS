{
  "name": "freedom-chms",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run --project unit",
    "test:rules": "firebase emulators:exec --only firestore --project demo-freedom-chms \"vitest run --project rules\"",
    "test:all": "npm test && npm run test:rules",
    "emulators": "firebase emulators:start --project demo-freedom-chms --import=.emulator-data --export-on-exit",
    "bootstrap": "node scripts/bootstrap.mjs",
    "set-password": "node scripts/set-password.mjs",
    "icons": "python3 scripts/make-icons.py"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "jspdf": "^3.0.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.0",
    "read-excel-file": "^5.8.8"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "firebase-admin": "^13.5.0",
    "firebase-tools": "^15.0.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.7"
  }
}
